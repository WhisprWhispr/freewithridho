rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: cek apakah user adalah admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'ridhosandhika18022022@gmail.com';
    }

    // Helper: cek apakah user sudah login
    function isLoggedIn() {
      return request.auth != null;
    }

    // Helper: cek apakah user adalah partner
    function isApprovedPartner() {
      return isLoggedIn() && exists(/databases/$(database)/documents/partners/$(request.auth.uid)) && get(/databases/$(database)/documents/partners/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Projects ──────────────────────────────────────
    // Semua orang bisa baca (home & detail). Hanya yang login bisa write.
    match /projects/{projectId} {
      allow read, list: if true;
      allow write: if isLoggedIn();
    }

    // ── Transactions ──────────────────────────────────
    // User bisa baca transaksinya sendiri secara realtime (onSnapshot).
    // Admin bisa baca semua.
    match /transactions/{transactionId} {
      allow get: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      // Izinkan query/list (untuk onSnapshot & getDocs dengan where)
      allow list: if isLoggedIn();
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────
    // Bisa dibaca publik (untuk deteksi sandbox/production).
    match /settings/{document=**} {
      allow read, list: if true;
      allow write: if isLoggedIn();
    }

    // ── Ratings ───────────────────────────────────────
    // Semua bisa baca, user login bisa tulis miliknya sendiri.
    match /ratings/{userId} {
      allow read, list: if true;
      allow write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Partners ──────────────────────────────────────
    // Siapapun bisa daftar (create). User login bisa baca.
    // Admin bisa read/update/delete semua.
    match /partners/{partnerId} {
      allow create: if true;
      allow get: if isLoggedIn() || resource.data.status == 'approved';
      allow list: if isLoggedIn();
      allow delete: if isAdmin();
      allow read: if true; 
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == resource.data.userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appealRequested', 'appealedAt']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'affiliateBalance']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalEarnings'])
        )) ||
        // Buyer menambahkan komisi referral
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliateBalance', 'affiliateCount', 'balance'])
      );
    }

    // ── Withdrawals ───────────────────────────────────
    // User login bisa buat & baca miliknya. Admin bisa semua.
    match /withdrawals/{withdrawalId} {
      allow create: if isLoggedIn();
      allow get: if isLoggedIn() && (
        resource.data.partnerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── Banned Users ──────────────────────────────────
    // Baca publik (untuk cek blacklist saat login/register).
    match /banned_users/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────
    // Semua bisa baca, user login bisa tulis miliknya.
    match /reviews/{projectId}/userReviews/{userId} {
      allow read, list: if true;
      allow write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Discussions ───────────────────────────────────
    // Semua bisa baca, user login bisa komentar & hapus miliknya.
    match /discussions/{projectId}/comments/{commentId} {
      allow read, list: if true;
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isLoggedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Promo Codes ───────────────────────────────────
    // Baca publik (untuk validasi kode promo). Hanya admin yang write.
    match /promoCodes/{code} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // ── Wishlists ─────────────────────────────────────
    // Hanya owner yang bisa baca & tulis wishlist miliknya.
    match /wishlists/{userId} {
      allow read, list, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Users ─────────────────────────────────────────
    // Semua bisa baca (untuk lookup kode referral).
    // Hanya owner yang bisa tulis, plus admin & sistem referral.
    match /users/{userId} {
      allow read, list: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        // Sistem referral menambahkan saldo
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralBalance', 'referralCount'])
      );
    }

    // ── Admin Stats / Aggregates ───────────────────────
    match /adminStats/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────
    // Semua orang bisa baca (siapa pun perlu lihat notif promo).
    // Hanya admin yang bisa buat/hapus notif baru.
    // User login bisa update (untuk menandai readBy saja).
    match /notifications/{notifId} {
      allow read, list: if true;
      allow create: if isAdmin() || isApprovedPartner();
      allow delete: if isAdmin();
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

  }
}
