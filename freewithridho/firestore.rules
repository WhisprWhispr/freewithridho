rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: cek apakah user adalah admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'ridhosandhika18022022@gmail.com';
    }

    // Helper: cek apakah user sudah login
    function isLoggedIn() {
      return request.auth != null;
    }

    // ── Projects ──────────────────────────────────────
    match /projects/{projectId} {
      allow read, list: if true;
      allow write: if isLoggedIn();
    }

    // ── Transactions ──────────────────────────────────
    match /transactions/{transactionId} {
      allow get: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isLoggedIn();
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────
    match /settings/{document=**} {
      allow read, list: if true;
      allow write: if isLoggedIn();
    }

    // ── Ratings ───────────────────────────────────────
    match /ratings/{userId} {
      allow read, list: if true;
      allow write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Partners ──────────────────────────────────────
    // PENTING: Ubah bagian ini jadi if true agar tidak error di HP!
    match /partners/{partnerId} {
      allow create: if true;
      allow read, list: if true; 
      allow delete: if isAdmin();
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (request.auth.uid == resource.data.userId && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appealRequested', 'appealedAt']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'affiliateBalance']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalEarnings'])
        )) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['affiliateBalance', 'affiliateCount', 'balance'])
      );
    }

    // ── Withdrawals ───────────────────────────────────
    match /withdrawals/{withdrawalId} {
      allow create: if isLoggedIn();
      allow get: if isLoggedIn() && (
        resource.data.partnerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── Banned Users ──────────────────────────────────
    match /banned_users/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────
    match /reviews/{projectId}/userReviews/{userId} {
      allow read, list: if true;
      allow write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Discussions ───────────────────────────────────
    match /discussions/{projectId}/comments/{commentId} {
      allow read, list: if true;
      allow create: if isLoggedIn();
      allow delete: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isLoggedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Promo Codes ───────────────────────────────────
    match /promoCodes/{code} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    // ── Wishlists ─────────────────────────────────────
    match /wishlists/{userId} {
      allow read, list, write: if isLoggedIn() && request.auth.uid == userId;
    }

    // ── Users ─────────────────────────────────────────
    match /users/{userId} {
      allow read, list: if true;
      allow create, delete: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['referralBalance', 'referralCount'])
      );
    }

    // ── Admin Stats / Aggregates ───────────────────────
    match /adminStats/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────
    match /notifications/{notifId} {
      allow read, list: if true;
      allow create: if isAdmin() || isLoggedIn();
      allow delete: if isAdmin();
      allow update: if isLoggedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
    }

    // ── Feedbacks ─────────────────────────────────────
    match /feedbacks/{docId} {
      allow read, list: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // ── Catch-all: Koleksi lain bisa dibaca publik ────
    match /{document=**} {
      allow read, list: if true;
    }

  }
}
