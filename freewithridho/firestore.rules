rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Semua orang bisa baca (untuk home & detail). Hanya admin (user login) yang bisa tambah/edit data.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User hanya bisa baca transaksinya sendiri. Admin bisa baca semua.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.email == 'ridhosandhika18022022@gmail.com'
      );
      allow write: if false;
    }

    // Settings (API Keys, dll) hanya bisa dibaca dan ditulis oleh admin
    match /settings/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Ratings: Anyone can read, logged-in users can write their own rating
    match /ratings/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Partners: Anyone can create, users can read their own. Admin can read/update all.
    match /partners/{partnerId} {
      allow create: if true;
      allow read: if request.auth != null || resource.data.status == 'approved';
      allow update, delete: if request.auth != null && request.auth.token.email == 'ridhosandhika18022022@gmail.com';
    }

    // Withdrawals: Only logged-in users can create. Admin can read and update.
    match /withdrawals/{withdrawalId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'ridhosandhika18022022@gmail.com';
    }
  }
}
